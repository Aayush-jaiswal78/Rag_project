# Copy this file to .env and fill in your real values.
# .env itself is git-ignored — never commit real keys.

OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=gpt-5.6-luna
CHAT_API_KEY=enter api key
CHAT_BASE_URL=https://api.experientiallabs.ai/v1

# Which OpenAI models to use (chat = generation, embedding = vector store)
#CHAT_MODEL=gpt-4o-mini
#EMBEDDING_MODEL=text-embedding-3-small

# Where raw source documents live, and where the Chroma index is persisted
DATA_DIR=data/raw
CHROMA_PERSIST_DIR=vectorstore/chroma_db

# Chunking config used by ingestion/splitter.py
CHUNK_SIZE=1000
CHUNK_OVERLAP=150